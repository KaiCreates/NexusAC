# NexusAC website — local development configuration.
# This file is gitignored. Never commit it, and never paste DATABASE_URL anywhere
# public: it is full access to the database.

# Any Postgres. Neon: copy the *pooled* connection string from the dashboard.
DATABASE_URL=postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Only for scripts/copy_database.py (moving data off the old Supabase database).
# SOURCE_DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require

APP_URL=https://your-site.vercel.app

# Optional WebRTC live-stream provider. Keep the secret only in website-host
# environment variables (Render/Vercel), never in FiveM config or browser code.
# Create a Cloudflare Realtime SFU app, then set both values to enable it.
CLOUDFLARE_REALTIME_APP_ID=
CLOUDFLARE_REALTIME_APP_SECRET=

# Retention (days). Defaults keep a free 0.5 GB database comfortably under its limit.
# MEDIA_RETENTION_DAYS=14
# EVIDENCE_RETENTION_DAYS=30
# EVENT_RETENTION_DAYS=7
# DB_SOFT_LIMIT_MB=400
