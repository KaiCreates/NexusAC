# NexusAC website — local development configuration.
# This file is gitignored. Never commit it, and never paste SUPABASE_SECRET_KEY
# or DATABASE_URL anywhere public: either one is full access to the project.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Supavisor transaction pooler. Supabase's direct host is IPv6 only, which most
# home connections and every Vercel function cannot reach.
DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require

APP_URL=https://your-site.vercel.app

# Supabase ships email confirmation ON with a mailer limited to a few messages an
# hour, which makes sign-up look broken. False creates accounts pre-confirmed.
# Set it to true once you have configured your own SMTP provider in Supabase.
REQUIRE_EMAIL_CONFIRMATION=false
